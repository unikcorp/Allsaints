# All Saints Public School - Environment Configuration Template
PORT=5000
NODE_ENV=production

# Hostinger MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=allsaints_school_db
DB_USER=allsaints-admin
DB_PASSWORD=YOUR_SECURE_HOSTINGER_PASSWORD_HERE
DB_PASS=YOUR_SECURE_HOSTINGER_PASSWORD_HERE

# Allowed browser origin(s) for CORS, comma-separated (no trailing slash)
FRONTEND_URL=https://allsaints.unikcorp.org

# JWT Secret for Admin Auth
JWT_SECRET=GENERATE_WITH__node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"


# Gmail SMTP for notifications (optional)
GMAIL_APP_PASSWORD=
